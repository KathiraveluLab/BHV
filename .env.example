# Security
BHV_SECRET=your-secure-random-secret-key-here-minimum-32-characters
DEBUG=false
SESSION_MAX_AGE=86400

# Database
DATABASE_URL=sqlite:///./bhv.db
# For PostgreSQL: postgresql://user:password@localhost/dbname
# For MySQL: mysql+pymysql://user:password@localhost/dbname
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis/Cache (optional - uses in-memory cache if not set)
REDIS_URL=redis://localhost:6379/0

# Cache TTL (in seconds)
CACHE_TTL_IMAGES=300

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=data/images
IMAGE_QUALITY=85
MAX_IMAGE_DIMENSION=4096

# Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Server
HOST=127.0.0.1
PORT=8000
WORKERS=1
